+#!/usr/bin/env python3
+"""Vendor the real Tufty 2350 badgeware runtime into runtime2026/firmware.
+
+The GitHub Universe 2026 badge runs a derivative of pimoroni/tufty2350. This
+copies that firmware's Python runtime and ROM fonts verbatim, then applies the
+smallest patches needed to run it on the simulator's C frame loop. Every patch
+asserts that its target text exists exactly once, so a firmware change that
+moves the code fails loudly instead of silently running unpatched code.
+
+Usage: tools/sync_runtime_2026.py /path/to/tufty2350
+"""
+
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent.parent
+OUT = HERE / "runtime2026" / "firmware"
+
+# (file, old, new, why)
+PATCHES = [
+    (
+        "badgeware/badge.py",
+        "MODEL = os.uname().machine[9:-17].lower()",
+        'MODEL = "tufty"',
+        "the unix port's os.uname() does not name the board",
+    ),
+    (
+        "badgeware/badge.py",
+        "builtins.screen = image(display.WIDTH, display.HEIGHT, memoryview(display))",
+        "builtins.screen = image(display.WIDTH, display.HEIGHT, display.buffer)",
+        "a Python display stub cannot expose the buffer protocol",
+    ),
+    (
+        "badgeware/__init__.py",
+        '__import__(".frozen/badgeware/badge")\n'
+        '__import__(".frozen/badgeware/math")\n'
+        '__import__(".frozen/badgeware/text")\n'
+        '__import__(".frozen/badgeware/filesystem")\n'
+        '__import__(".frozen/badgeware/memory")\n'
+        '__import__(".frozen/badgeware/rtc")\n'
+        'State = __import__(".frozen/badgeware/state").State\n',
+        '__import__("/firmware/badgeware/badge")\n'
+        '__import__("/firmware/badgeware/math")\n'
+        '__import__("/firmware/badgeware/text")\n'
+        '__import__("/firmware/badgeware/filesystem")\n'
+        '__import__("/firmware/badgeware/memory")\n'
+        '__import__("/firmware/badgeware/rtc")\n'
+        'State = __import__("/firmware/badgeware/state").State\n',
+        "the runtime is not frozen into the simulator binary",
+    ),
+]
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        print(__doc__)
+        return 2
+    src = Path(sys.argv[1]).resolve()
+    common = src / "modules" / "common"
+    if not (common / "badgeware" / "badge.py").is_file():
+        print(f"error: {src} is not a tufty2350 checkout", file=sys.stderr)
+        return 2
+    rev = subprocess.run(
+        ["git", "-C", str(src), "rev-parse", "HEAD"], capture_output=True, text=True
+    ).stdout.strip() or "unknown"
+
+    if OUT.exists():
+        shutil.rmtree(OUT)
+    (OUT / "badgeware").mkdir(parents=True)
+    for f in sorted((common / "badgeware").glob("*.py")):
+        shutil.copy(f, OUT / "badgeware" / f.name)
+    for name in ("board.py", "wifi.py", "easing.py", "fetch.py"):
+        shutil.copy(common / name, OUT / name)
+    shutil.copytree(src / "romfs" / "fonts", OUT / "rom" / "fonts")
+
+    for rel, old, new, why in PATCHES:
+        path = OUT / rel
+        text = path.read_text()
+        count = text.count(old)
+        if count != 1:
+            print(f"error: patch target in {rel} found {count} times ({why})", file=sys.stderr)
+            return 1
+        path.write_text(text.replace(old, new))
+
+    (OUT / "SOURCE.txt").write_text(
+        f"pimoroni/tufty2350 {rev}\n"
+        "modules/common/badgeware/*.py, board.py, wifi.py, easing.py, fetch.py, romfs/fonts\n"
+        "Patched by tools/sync_runtime_2026.py:\n"
+        + "".join(f"  {rel}: {why}\n" for rel, _o, _n, why in PATCHES)
+    )
+    print(f"synced {rev} into {OUT}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
