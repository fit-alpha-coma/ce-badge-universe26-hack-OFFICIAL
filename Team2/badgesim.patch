+# Display stub: the simulator renders `simulator.framebuffer` after every frame,
+# so update() has nothing to push. fullres() switches between the 160x120
+# pixel-doubled mode and the 320x240 HIRES mode, as display.fullres() does.
+
+import simulator
+
+
+class ST7789:
+    def __init__(self):
+        self.WIDTH = 160
+        self.HEIGHT = 120
+        self.buffer = simulator.framebuffer
+        self._backlight = 1.0
+        simulator.resolution(160, 120)
+
