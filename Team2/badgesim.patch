diff --git a/runtime2026/badge2026.py b/runtime2026/badge2026.py
new file mode 100644
index 0000000..27c2aaa
--- /dev/null
+++ b/runtime2026/badge2026.py
@@ -0,0 +1,60 @@
+# GitHub Universe 2026 additions on top of the Tufty 2350 runtime.
+#
+# Source of truth for this surface: badger/home hardware/README.md and
+# badge/AGENTS.md (logical actions, touched/direction/imu/upside_down) and the
+# 2026 apps that call it. The GitHub firmware's implementation is not public,
+# so these are emulations of the documented behaviour:
+#
+# - LEFT/RIGHT/SELECT are the physical A/B/C switches, which the 2026 layout
+#   puts left to right on the bottom row. The touch D-pad and pads report the
+#   same logical actions, so one key per action stands in for both sources.
+# - BACK and MENU exist only on the touch face.
+# - imu() returns raw LSM6DS3 counts (about 16384 per g at the default range),
+#   matching the firmware's lsm6ds3 driver. `tilt` simulates a tilted badge.
+
+import builtins
+import math
+import machine
+import _input
+
+_b = machine.Pin.board
+builtins.BUTTON_LEFT = _b.BUTTON_A
+builtins.BUTTON_RIGHT = _b.BUTTON_B
+builtins.BUTTON_SELECT = _b.BUTTON_C
+builtins.BUTTON_BACK = _input.TOUCH_BACK
+builtins.BUTTON_MENU = _input.TOUCH_MENU
+
+COUNTS_PER_G = 16384
+tilt = [0.0, 0.0]  # (x, y) in g, set by the harness
+
+
+def _touched(self, button=None):
+    if button is None:
+        return _input.held
+    return button in _input.held
+
+
+def _direction(self):
+    held = _input.held
+    x = (BUTTON_RIGHT in held) - (BUTTON_LEFT in held)
+    y = (BUTTON_DOWN in held) - (BUTTON_UP in held)
+    if x and y:
+        return vec2(x * 0.70710678, y * 0.70710678)
+    return vec2(x, y)
+
+
+def _imu(self):
+    gx, gy = tilt
+    gz = math.sqrt(max(0.0, 1.0 - gx * gx - gy * gy))
+    return (int(gx * COUNTS_PER_G), int(gy * COUNTS_PER_G), int(gz * COUNTS_PER_G), 0, 0, 0)
+
+
+def _upside_down(self):
+    return False
+
+
+cls = type(badge)
+cls.touched = _touched
+cls.direction = _direction
+cls.imu = _imu
+cls.upside_down = _upside_down
diff --git a/runtime2026/stubs/_input.py b/runtime2026/stubs/_input.py
new file mode 100644
index 0000000..da2c0a5
--- /dev/null
+++ b/runtime2026/stubs/_input.py
@@ -0,0 +1,68 @@
+# Python stand-in for the firmware's _input C module
+# (pimoroni/tufty2350 modules/c/input/input.cpp).
+#
+# Same contract: poll() latches the switch state and the millisecond clock once
+# per frame; held/pressed/released/changed are tuples of the Pin objects in
+# machine.Pin.board, so `BUTTON_A in badge.pressed()` works by identity.
+# The Universe 2026 badge adds the touch-only Back and Menu pads, which have no
+# Pin; they appear here as TOUCH_BACK and TOUCH_MENU.
+
+import machine
+import simulator
+
+
+class _TouchPad:
+    def __init__(self, name):
+        self.name = name
+
+    def __repr__(self):
+        return "TouchPad(%s)" % self.name
+
+
+TOUCH_BACK = _TouchPad("BACK")
+TOUCH_MENU = _TouchPad("MENU")
+
+_b = machine.Pin.board
+_MAP = (
+    (0x20, _b.BUTTON_HOME),
+    (0x10, _b.BUTTON_A),
+    (0x08, _b.BUTTON_B),
+    (0x04, _b.BUTTON_C),
+    (0x02, _b.BUTTON_UP),
+    (0x01, _b.BUTTON_DOWN),
+    (0x40, TOUCH_BACK),
+    (0x80, TOUCH_MENU),
+)
+
+held = ()
+pressed = ()
+released = ()
+changed = ()
+ticks = 0
+ticks_delta = 0
+
+# Scripted input for headless runs: a callable returning extra mask bits.
+script = None
+
+_buttons = 0
+_last_ticks = 0
+
+
+def _items(mask):
+    return tuple(obj for bit, obj in _MAP if mask & bit)
+
+
+def poll():
+    global held, pressed, released, changed, ticks, ticks_delta, _buttons, _last_ticks
+    b = simulator.buttons
+    if script is not None:
+        b |= script()
+    ch = b ^ _buttons
+    _buttons = b
+    held = _items(b)
+    pressed = _items(b & ch)
+    released = _items(~b & ch & 0xFF)
+    changed = _items(ch)
+    _last_ticks = ticks
+    ticks = simulator.ticks
+    ticks_delta = ticks - _last_ticks
diff --git a/runtime2026/stubs/machine.py b/runtime2026/stubs/machine.py
new file mode 100644
index 0000000..92a1c5e
--- /dev/null
+++ b/runtime2026/stubs/machine.py
@@ -0,0 +1,115 @@
+# machine stub for the Universe 2026 badge.
+#
+# Pin names follow pimoroni/tufty2350 board/pins.csv and the 2026 schematic.
+# Switch pins read the simulator's button mask, active low like the real
+# pull-ups, so `Pin.board.BUTTON_A.value() == 0` while it is pressed. PWM on the
+# CL0..CL3 case-light pins is forwarded to the window.
+
+import simulator
+
+# simulator.buttons bits (see micropython/main.c)
+_SWITCH_BITS = {
+    "BUTTON_HOME": 0x20,
+    "BUTTON_A": 0x10,
+    "BUTTON_B": 0x08,
+    "BUTTON_C": 0x04,
+    "BUTTON_UP": 0x02,
+    "BUTTON_DOWN": 0x01,
+}
+_CASE_LIGHTS = ("CL0", "CL1", "CL2", "CL3")
+_duty = [0.0, 0.0, 0.0, 0.0]
+
+
+class Pin:
+    IN = 0
+    OUT = 1
+    PULL_UP = 1
+    PULL_DOWN = 2
+    IRQ_FALLING = 4
+    IRQ_RISING = 8
+
+    def __init__(self, name, *args, **kwargs):
+        self.name = name
+        self._bit = _SWITCH_BITS.get(name, 0)
+        self._out = 0
+
+    def value(self, v=None):
+        if v is not None:
+            self._out = v
+            return None
+        if self._bit:
+            return 0 if simulator.buttons & self._bit else 1
+        return self._out
+
+    def irq(self, *args, **kwargs):
+        return None
+
+    def __repr__(self):
+        return "Pin(%s)" % self.name
+
+
+class _Board:
+    def __init__(self):
+        for name in tuple(_SWITCH_BITS) + _CASE_LIGHTS + (
+            "VBAT_SENSE", "SENSE_1V1", "VBUS_DETECT", "CHARGE_STAT", "LIGHT_SENSE",
+            "RTC_ALARM", "IR_TX", "IR_RX", "BUTTON_RESET", "BUTTON_INT",
+        ):
+            setattr(self, name, Pin(name))
+
+
+Pin.board = _Board()
+
+
+class ADC:
+    # plausible readings: 3.93 V battery, 1.1 V reference, indoor light
+    _READINGS = {"VBAT_SENSE": 39000, "SENSE_1V1": 21845, "LIGHT_SENSE": 20000}
+
+    def __init__(self, pin):
+        self._name = pin.name if isinstance(pin, Pin) else str(pin)
+
+    def read_u16(self):
+        return self._READINGS.get(self._name, 0)
+
+
+class PWM:
+    def __init__(self, pin, *args, **kwargs):
+        self._index = _CASE_LIGHTS.index(pin.name) if pin.name in _CASE_LIGHTS else None
+
+    def freq(self, f=None):
+        return 500
+
+    def duty_u16(self, duty=None):
+        if duty is None:
+            return 0 if self._index is None else int(_duty[self._index] * 65535)
+        if self._index is not None:
+            _duty[self._index] = duty / 65535
+            simulator.caselights(*_duty)
+        return None
+
+
+class I2C:
+    def __init__(self, *args, **kwargs):
+        pass
+
+
+class RTC:
+    def datetime(self, *args):
+        if args:
+            return None
+        import time
+        t = time.localtime()
+        return (t[0], t[1], t[2], t[6], t[3], t[4], t[5], 0)
+
+
+def unique_id():
+    return b"\x20\x26\xba\xd9\xe5\x00\x00\x01"
+
+
+def reset():
+    import sys
+    print("machine.reset()")
+    sys.exit(255)
+
+
+def freq(*args):
+    return 200_000_000
